# Chrome Remote Debugging WebSocket Configuration
CHROME_DEBUG_PORT=9222
CHROME_USER_DATA_DIR="C:/Users/YourUsername/AppData/Local/Google/Chrome/User Data"

# Browser Profiles
LINKEDIN_PROFILE="Profile 1"
GENERATION_PROFILE="Default"

# AI Provider API Keys (Optional if running via automated browser session)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Publishing Preferences
DEFAULT_TIMEZONE="America/Chicago"
DEFAULT_SCHEDULE_HOUR=11
DEFAULT_SCHEDULE_MINUTE=00
DEFAULT_AM_PM="AM"
ENABLE_HUMANIZER_FALLBACK=true
STRICT_ZERO_DOLLAR_SIGNS=true
